{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "applicationImage": {
      "type": "object",
      "properties": {
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" }
      }
    },
    "writer": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/applicationImage" }
      }
    },
    "applicationProcess": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/applicationImage" }
      }
    }
  },
  "properties": {
    "image": { "$ref": "#/$defs/applicationImage" },
    "workflowWorker": { "$ref": "#/$defs/writer" },
    "ices": { "$ref": "#/$defs/writer" },
    "sftpGateway": { "$ref": "#/$defs/applicationProcess" },
    "mcp": { "$ref": "#/$defs/applicationProcess" },
    "emailGateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["gateway", "relay", "inbound-relay"] },
        "smtpAuthRequired": { "type": "boolean" },
        "relay": {
          "type": "object",
          "properties": {
            "spoolSharedKey": { "type": "string" },
            "existingSpoolKeySecret": { "type": "string" },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "existingClaim": { "type": "string" }
              }
            },
            "db": {
              "type": "object",
              "properties": {
                "uri": { "type": "string" },
                "name": { "type": "string", "minLength": 1 },
                "existingSecret": { "type": "string" },
                "networkPolicyCIDRs": { "type": "array", "items": { "type": "string" } },
                "networkPolicyPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          }
        }
      }
    },
    "deploymentContractV2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceCommit": { "type": "string" },
        "contractFingerprint": { "type": "string" },
        "imageDigest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" }
      },
      "required": ["sourceCommit", "contractFingerprint", "imageDigest"]
    },
    "deploymentContractV3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceCommit": { "type": "string" },
        "contractFingerprint": { "type": "string" },
        "imageDigest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" }
      },
      "required": ["sourceCommit", "contractFingerprint", "imageDigest"]
    },
    "formatMigrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["automatic", "operator", "disabled"],
          "default": "automatic"
        },
        "orchestratorImage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "required": ["repository", "digest", "pullPolicy"]
        },
        "podTerminationTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60 },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "databaseCIDRs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "databasePort": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "kubernetesApiTargets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cidr": { "type": "string", "minLength": 1 },
                  "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                },
                "required": ["cidr", "port"]
              }
            }
          },
          "required": ["databaseCIDRs", "databasePort", "kubernetesApiTargets"]
        }
      },
      "required": ["mode", "orchestratorImage", "podTerminationTimeout", "backoffLimit", "activeDeadlineSeconds"]
    }
  }
}
