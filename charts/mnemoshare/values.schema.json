{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "applicationImage": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      }
    },
    "writer": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/applicationImage"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "prometheus": {
              "type": "object",
              "properties": {
                "serverAddress": {
                  "type": "string"
                },
                "query": {
                  "type": "string"
                },
                "threshold": {
                  "type": "string"
                },
                "activationThreshold": {
                  "type": "string"
                },
                "authenticationRef": {
                  "type": "string"
                }
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "applicationProcess": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/applicationImage"
        }
      }
    }
  },
  "properties": {
    "image": {
      "$ref": "#/$defs/applicationImage"
    },
    "api": {
      "type": "object",
      "properties": {
        "embeddedWorkers": {
          "type": "boolean"
        }
      }
    },
    "workflowWorker": {
      "$ref": "#/$defs/writer"
    },
    "ices": {
      "$ref": "#/$defs/writer"
    },
    "sftpGateway": {
      "$ref": "#/$defs/applicationProcess"
    },
    "mcp": {
      "$ref": "#/$defs/applicationProcess"
    },
    "emailGateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "gateway",
            "relay",
            "inbound-relay"
          ]
        },
        "smtpAuthRequired": {
          "type": "boolean"
        },
        "relay": {
          "type": "object",
          "properties": {
            "spoolSharedKey": {
              "type": "string"
            },
            "existingSpoolKeySecret": {
              "type": "string"
            },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "existingClaim": {
                  "type": "string"
                }
              }
            },
            "db": {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "existingSecret": {
                  "type": "string"
                },
                "networkPolicyCIDRs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "networkPolicyPort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        },
        "spool": {
          "type": "object",
          "properties": {
            "dir": {
              "type": "string",
              "minLength": 1
            },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                },
                "accessModes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "existingClaim": {
                  "type": "string"
                }
              }
            }
          }
        },
        "misdirected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkTimeoutMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "maxHeldBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "syncIntervalSec": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      }
    },
    "deploymentContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceCommit": {
          "type": "string"
        },
        "contractFingerprint": {
          "type": "string"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      },
      "required": [
        "sourceCommit",
        "contractFingerprint",
        "imageDigest"
      ]
    },
    "formatMigrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "automatic",
            "operator",
            "disabled"
          ],
          "default": "automatic",
          "description": "automatic renders chart-owned migration orchestration; operator renders no chart-owned migration control resources; disabled retains stale-state fencing and cleanup without executing migrations"
        },
        "orchestratorImage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "digest",
            "pullPolicy"
          ]
        },
        "podTerminationTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "databaseCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "databasePort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "kubernetesApiTargets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cidr": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "required": [
                  "cidr",
                  "port"
                ]
              }
            }
          },
          "required": [
            "databaseCIDRs",
            "databasePort",
            "kubernetesApiTargets"
          ]
        }
      },
      "required": [
        "mode",
        "orchestratorImage",
        "podTerminationTimeout",
        "backoffLimit",
        "activeDeadlineSeconds"
      ]
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "createNamespace": {
          "type": "boolean"
        },
        "namespaceSuffix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^-[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "healthPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "staging": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[a-f0-9]{64})?$"
                },
                "pullPolicy": {
                  "type": "string"
                }
              }
            },
            "secretName": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "allowPlaintext": {
                  "type": "boolean"
                },
                "secretName": {
                  "type": "string"
                },
                "issuerRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string"
                    }
                  }
                },
                "duration": {
                  "type": "string"
                },
                "renewBefore": {
                  "type": "string"
                },
                "clientCASecret": {
                  "type": "string"
                }
              }
            },
            "egress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kubernetesApiTargets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cidr",
                      "port"
                    ],
                    "properties": {
                      "cidr": {
                        "type": "string"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    }
                  }
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultImage": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "repository": {
                      "type": "string"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^((sha256:)?[a-f0-9]{64})?$"
                    }
                  }
                }
              ]
            },
            "commandAllow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^,\\s]+$"
              }
            },
            "commandDeny": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^,\\s]+$"
              }
            },
            "allowedRegistries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requireImageDigest": {
              "type": "boolean"
            },
            "egressAllowedCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "defaultCPU": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxCPU": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "defaultMemory": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxMemory": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "defaultEphemeralStorage": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxEphemeralStorage": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "defaultTimeoutSeconds": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxTimeoutSeconds": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxConcurrentJobs": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxInputBytes": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxOutputBytes": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              }
            }
          }
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hard": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          }
        }
      }
    }
  }
}
