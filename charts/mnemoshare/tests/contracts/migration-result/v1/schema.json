{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemoshare.com/contracts/migration-result/v1/schema.json",
  "title": "MnemoShare migration result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "planDigest"],
  "properties": {
    "decision": {"enum": ["ordinary", "maintenance"]},
    "planDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
