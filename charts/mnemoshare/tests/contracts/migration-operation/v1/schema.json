{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemoshare.com/contracts/migration-operation/v1/schema.json",
  "title": "MnemoShare migration operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "fingerprint", "executable", "commands", "planning", "schemaOwnership", "bootstrapPolicy", "universeFlag", "governedProcesses", "universes", "result", "lifecycle"],
  "properties": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generator", "sourceFingerprint"],
      "properties": {
        "schema": {"const": "mnemoshare.migration-operation.v1"},
        "generator": {"type": "string", "minLength": 1},
        "sourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "executable": {"const": "/usr/local/bin/mnemoshare-migrate"},
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reset", "plan", "apply", "verify", "status"],
      "properties": {
        "reset": {"$ref": "#/$defs/resetCommand"},
        "plan": {"$ref": "#/$defs/planCommand"},
        "apply": {"$ref": "#/$defs/applyCommand"},
        "verify": {"$ref": "#/$defs/verifyCommand"},
        "status": {"$ref": "#/$defs/statusCommand"}
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modeFlag", "defaultMode", "allowedModes", "omitDefault"],
      "properties": {
        "modeFlag": {"const": "--planning-mode"},
        "defaultMode": {"const": "ordinary"},
        "allowedModes": {"const": ["ordinary", "legacy-bootstrap"]},
        "omitDefault": {"const": true}
      }
    },
    "schemaOwnership": {"const": "exclusive-operation"},
    "bootstrapPolicy": {"const": "provision-untracked"},
    "universeFlag": {"const": "--universe"},
    "governedProcesses": {"type": "array", "minItems": 1},
    "universes": {"type": "array", "minItems": 1},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "mediaType", "resultFlag", "planDigestField", "digestEncoding", "progressSchema", "progressSchemaFingerprint", "statusFlag", "terminationFileFlag", "planFile", "resultFile", "statusFile", "terminationFile", "deadlineOutcome"],
      "properties": {
        "schema": {"const": "mnemoshare.migration-result.v1"},
        "mediaType": {"const": "application/json"},
        "resultFlag": {"const": "--result"},
        "planDigestField": {"const": "planDigest"},
        "digestEncoding": {"const": "sha256-hex-lowercase"},
        "progressSchema": {"const": "mnemoshare.migration-progress.v1"},
        "progressSchemaFingerprint": {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "statusFlag": {"const": "--status"},
        "terminationFileFlag": {"const": "--termination-file"},
        "planFile": {"type":"object","additionalProperties":false,"required":["writerMaxBytes","readerMaxBytes","target","fileMode","symlinks","publication","retryFence"],"properties":{"writerMaxBytes":{"const":16777216},"readerMaxBytes":{"const":16777216},"target":{"const":"same-parent-atomic-create-or-replace"},"fileMode":{"const":"0644-generated-regular"},"symlinks":{"const":"reject-final-target-symlink-or-nonregular"},"publication":{"const":"same-parent-temp-fsync-rename-fsync-parent"},"retryFence":{"const":"capture-temp-inode-verify-visible-same-inode-and-exact-bytes-fsync-file-and-parent-then-reverify-inode"}}},
        "resultFile": {"type":"object","additionalProperties":false,"required":["maxBytes","target","fileMode","parentTrust","symlinks","publication","retryFence"],"properties":{"maxBytes":{"const":4096},"target":{"const":"same-parent-atomic-create-or-replace"},"fileMode":{"const":"0600-caller-owned-regular-single-link"},"parentTrust":{"const":"caller-owned-owner-writable-not-world-writable"},"symlinks":{"const":"reject-final-target-symlink-or-nonregular"},"publication":{"const":"atomic-temp-fsync-rename-fsync-parent"},"retryFence":{"const":"generation-inode-and-exact-visible-bytes-then-fsync-parent-and-reverify-generation"}}},
        "statusFile": {"type":"object","additionalProperties":false,"required":["maxBytes","failureMaxBytes","fileMode","parentTrust","symlinks","durability","deadlineTerminalState","futureClockSkew","startupProgress","sequence","writeOrdering","ioTimeout"],"properties":{"maxBytes":{"const":4096},"failureMaxBytes":{"const":2048},"fileMode":{"const":"0600-caller-owned-regular-single-link"},"parentTrust":{"const":"caller-owned-not-group-or-world-writable"},"symlinks":{"const":"reject"},"durability":{"const":"fsync-file-rename-fsync-parent"},"deadlineTerminalState":{"const":"stalled"},"futureClockSkew":{"const":"30s"},"startupProgress":{"const":"before-plan-and-persistence-open"},"sequence":{"const":"required-positive-integer"},"writeOrdering":{"const":"compare-and-swap-monotonic-sequence-latest-wins"},"ioTimeout":{"const":"30s"}}},
        "terminationFile": {"type":"object","additionalProperties":false,"required":["maxBytes","failureMaxBytes","target","kubernetesTerminationMessagePath","pathBinding","fileMode","parentTrust","symlinks","publication","content","writeFailure","ioTimeout"],"properties":{"maxBytes":{"const":4096},"failureMaxBytes":{"const":2048},"target":{"const":"<status-dir>/termination.json"},"kubernetesTerminationMessagePath":{"const":"<status-dir>/termination.json"},"pathBinding":{"const":"equal-to-termination-file-argument"},"fileMode":{"const":"0600-caller-owned-regular-single-link"},"parentTrust":{"const":"caller-owned-not-group-or-world-writable"},"symlinks":{"const":"reject"},"publication":{"const":"atomic-temp-fsync-rename-fsync-parent"},"content":{"const":"canonical-terminal-progress-snapshot-only"},"writeFailure":{"const":"fail-command"},"ioTimeout":{"const":"30s"}}},
        "deadlineOutcome": {"type":"object","additionalProperties":false,"required":["inactivityDeadline","absoluteDeadline","timeoutState","probeOutcome","applyOutcome"],"properties":{"inactivityDeadline":{"const":"5m"},"absoluteDeadline":{"const":"6h"},"timeoutState":{"const":"stalled"},"probeOutcome":{"const":"unhealthy-after-terminal-publication"},"applyOutcome":{"const":"terminal-publication-required-before-exit"}}}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "failureAfterCommitted"],
      "properties": {
        "order": {"const": ["plan-all", "down", "apply-verify-all", "up"]},
        "failureAfterCommitted": {"const": "remain-down-forward-repair-no-rollback"}
      }
    }
  },
  "$defs": {
    "resetCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {"const": "/usr/local/bin/mnemoshare-migrate"},
        "args": {"const": ["pre-1-reset-format-ledger", "--exclusive", "--confirm-before-first-1.0", "--status", "<status-file>", "--termination-file", "<status-dir>/termination.json", "--max-inactivity", "5m", "--absolute-deadline", "6h"]}
      },
      "required": ["executable", "args"]
    },
    "planCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {"const": "/usr/local/bin/mnemoshare-migrate"},
        "args": {"const": ["plan", "--contract", "embedded", "--expect-contract-fingerprint", "<contract-fingerprint>", "--output", "<plan-file>", "--result", "<result-file>"]}
      },
      "required": ["executable", "args"]
    },
    "applyCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {"const": "/usr/local/bin/mnemoshare-migrate"},
        "args": {"const": ["apply", "--contract", "embedded", "--expect-contract-fingerprint", "<contract-fingerprint>", "--plan", "<plan-file>", "--expect-plan-digest", "<plan-digest>", "--exclusive", "--bootstrap-policy", "provision-untracked", "--status", "<status-file>", "--termination-file", "<status-dir>/termination.json"]}
      },
      "required": ["executable", "args"]
    },
    "verifyCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {"const": "/usr/local/bin/mnemoshare-migrate"},
        "args": {"const": ["verify", "--contract", "embedded", "--expect-contract-fingerprint", "<contract-fingerprint>", "--plan", "<plan-file>", "--expect-plan-digest", "<plan-digest>"]}
      },
      "required": ["executable", "args"]
    },
    "statusCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {"const": "/usr/local/bin/mnemoshare-migrate"},
        "args": {"const": ["status", "--file", "<status-file>", "--termination-file", "<status-dir>/termination.json", "--max-inactivity", "5m", "--absolute-deadline", "6h"]}
      },
      "required": ["executable", "args"]
    }
  }
}
