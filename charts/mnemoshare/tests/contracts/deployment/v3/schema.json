{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemoshare.com/contracts/deployment/v3/schema.json",
  "title": "MnemoShare deployment contract v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "fingerprint", "executables", "adapters"],
  "properties": {
    "provenance": {"$ref": "#/$defs/provenance"},
    "fingerprint": {"$ref": "#/$defs/digest"},
    "executables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/executable"}},
    "adapters": {"type": "array", "items": {"$ref": "#/$defs/adapter"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["schema", "generator", "source_fingerprint"], "properties": {"schema": {"const": "mnemoshare.deployment-contract.v3"}, "generator": {"$ref": "#/$defs/nonempty"}, "source_fingerprint": {"$ref": "#/$defs/digest"}}},
    "probe": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "path", "port"], "properties": {"kind": {"const": "http"}, "path": {"type": "string", "pattern": "^/"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "command"], "properties": {"kind": {"const": "process"}, "command": {"$ref": "#/$defs/strings"}}}
    ]},
    "optionalHTTPProbe": {"oneOf": [{"type": "object", "maxProperties": 0}, {"type": "object", "additionalProperties": false, "required": ["kind", "path", "port"], "properties": {"kind": {"const": "http"}, "path": {"type": "string", "pattern": "^/"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}]},
    "condition": {"type": "object", "additionalProperties": false, "required": ["name", "operator"], "properties": {"name": {"$ref": "#/$defs/nonempty"}, "operator": {"enum": ["equals", "set", "unset"]}, "value": {"$ref": "#/$defs/nonempty"}}, "allOf": [{"if": {"properties": {"operator": {"const": "equals"}}}, "then": {"required": ["value"]}, "else": {"not": {"required": ["value"]}}}]},
    "selectionCase": {"type": "object", "additionalProperties": false, "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}},
    "externalUniverse": {"type": "object", "additionalProperties": false, "required": ["id", "carrier", "environment", "surfaces"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "carrier": {"$ref": "#/$defs/nonempty"}, "environment": {"$ref": "#/$defs/strings"}, "surfaces": {"$ref": "#/$defs/strings"}}},
    "durableResource": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "path_environment", "lifecycle"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "kind": {"const": "filesystem"}, "path": {"type": "string", "pattern": "^/"}, "path_environment": {"$ref": "#/$defs/nonempty"}, "lifecycle": {"const": "process"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "persistence", "probe", "coexistence"], "properties": {
      "id": {"$ref": "#/$defs/nonempty"}, "selection": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selectionCase"}}, "args": {"$ref": "#/$defs/strings"},
      "kind": {"enum": ["api", "worker"]}, "persistence": {"enum": ["selected", "none"]}, "engines": {"$ref": "#/$defs/strings"}, "capabilities": {"$ref": "#/$defs/strings"}, "environment": {"$ref": "#/$defs/strings"},
      "probe": {"$ref": "#/$defs/probe"}, "liveness_probe": {"$ref": "#/$defs/optionalHTTPProbe"}, "coexistence": {"const": "application-peers"},
      "external_universes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/externalUniverse"}}, "durable_resources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/durableResource"}}
    }},
    "executable": {"type": "object", "additionalProperties": false, "required": ["id", "path", "default_profile", "profiles"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "path": {"$ref": "#/$defs/nonempty"}, "profile_selector": {"$ref": "#/$defs/nonempty"}, "default_profile": {"$ref": "#/$defs/nonempty"}, "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}}, "image_default": {"const": true}}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["executable", "processes", "probe"], "properties": {"executable": {"$ref": "#/$defs/nonempty"}, "args": {"$ref": "#/$defs/strings"}, "processes": {"$ref": "#/$defs/strings"}, "probe": {"$ref": "#/$defs/probe"}, "image_default": {"const": true}, "image_entrypoint": {"$ref": "#/$defs/strings"}, "entrypoint_pass_through": {"const": true}, "entrypoint_profile": {"enum": ["pass-through", "fips-pass-through"]}}}
  }
}
